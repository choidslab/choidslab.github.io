---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';

const [primaryEmail, ...secondaryEmails] = SITE.emails;
const description = `Contact ${SITE.siteName} — email, affiliation, and scholarly profiles. Open to research collaboration and discussion on AI-applied cybersecurity.`;
---

<Base title="Contact" description={description}>
  <section class="section">
    <div class="container">
      <span class="kicker">// CONTACT</span>
      <h1>Get in Touch</h1>
      <p class="contact-lead">
        I am open to research collaboration, academic discussion, and
        conversations about AI-applied cybersecurity. The fastest way to reach
        me is by email.
      </p>

      <div class="contact-grid">
        <div class="card contact-card">
          <span class="kicker">// EMAIL</span>
          <h2>Email</h2>
          <ul class="email-list" role="list">
            <li>
              <a class="email-link" href={`mailto:${primaryEmail}`}>
                {primaryEmail}
              </a>
              <span class="badge-accent">primary</span>
            </li>
            {
              secondaryEmails.map((email) => (
                <li>
                  <a class="email-link" href={`mailto:${email}`}>
                    {email}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card contact-card">
          <span class="kicker">// AFFILIATION</span>
          <h2>Affiliation</h2>
          <p class="affiliation-text">{SITE.affiliation}</p>
        </div>

        <div class="card contact-card">
          <span class="kicker">// PROFILES</span>
          <h2>Profiles</h2>
          <ul class="profile-list" role="list">
            <li>
              <a
                href={SITE.socials.googleScholar}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  class="profile-icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M12 3 1 9l4 2.18v4.99c0 .55.22 1.05.59 1.41C6.7 18.7 9.14 20 12 20s5.3-1.3 6.41-2.42c.37-.36.59-.86.59-1.41v-4.99L21.5 9.9v5.6c0 .28.22.5.5.5s.5-.22.5-.5V9.3c0-.18-.1-.35-.26-.44L12 3Zm0 2.29L18.82 9 12 12.71 5.18 9 12 5.29ZM17 15.99c-.02.02-1.83 1.51-5 1.51s-4.98-1.49-5-1.51v-3.63l5 2.73 5-2.73v3.63Z"
                  ></path>
                </svg>
                Google Scholar
              </a>
            </li>
            <li>
              <a
                href={SITE.socials.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  class="profile-icon"
                  viewBox="0 0 16 16"
                  width="18"
                  height="18"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  ></path>
                </svg>
                GitHub
              </a>
            </li>
          </ul>
        </div>
      </div>

      <p class="contact-note">
        <span class="prompt" aria-hidden="true">&gt;_</span>
        Whether you are working on malware detection, LLM security, or network
        defense — feel free to reach out.
      </p>
    </div>
  </section>
</Base>

<style>
  .contact-lead {
    max-width: var(--prose-width);
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 2.2rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }
  .contact-card {
    padding: 1.5rem 1.6rem;
  }
  .contact-card .kicker {
    margin-bottom: 0.3rem;
  }
  .contact-card h2 {
    font-size: 1.15rem;
    margin-bottom: 0.8rem;
  }

  .email-list,
  .profile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .email-list li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .email-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    word-break: break-all;
  }

  .affiliation-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .profile-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .profile-icon {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }
  .profile-list a:hover .profile-icon {
    color: var(--gold-text);
  }

  .contact-note {
    margin-top: 2.4rem;
    font-size: 0.98rem;
    color: var(--text-muted);
    max-width: var(--prose-width);
    border-top: 1px dashed var(--border);
    padding-top: 1.4rem;
  }
  .prompt {
    font-family: var(--font-mono);
    color: var(--gold-text);
    font-weight: 700;
    margin-right: 0.45rem;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
