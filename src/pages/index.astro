---
import Base from '../layouts/Base.astro';
import { SITE, AUTHOR_ME } from '../config/site';
import { researchAreas } from '../data/research';
import { publications } from '../data/publications';
import { getCollection } from 'astro:content';

const selectedPubs = publications.filter((p) => p.selected);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
    timeZone: 'UTC',
  });
---

<Base>
  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-prompt" aria-hidden="true">
          <span class="prompt-path">~/{SITE.handle}</span>
          <span class="prompt-dollar">$</span> whoami<span class="cursor"></span>
        </p>
        <h1>{SITE.siteName}</h1>
        <p class="hero-tagline">{SITE.tagline}</p>
        <p class="hero-intro">
          Ph.D. in Computer Science from Hanyang University, working at the
          intersection of artificial intelligence and cybersecurity. I build
          machine-learning and LLM-driven systems that detect document-based
          malware and malicious network traffic — and study how to make those
          defensive models trustworthy.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/research/">Explore Research</a>
          <a class="btn btn-ghost" href="/publications/">Publications</a>
        </div>
        <p class="hero-meta">{SITE.affiliation}</p>
      </div>

      <div class="hero-visual">
        <div class="photo-frame">
          <picture>
            <source srcset="/img/dschoi.webp" type="image/webp" />
            <img
              src="/img/dschoi.jpg"
              alt={`Portrait of ${AUTHOR_ME}`}
              width="640"
              height="640"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
          <span class="corner tl" aria-hidden="true"></span>
          <span class="corner br" aria-hidden="true"></span>
        </div>
        <div class="term-chip" aria-hidden="true">
          <span class="term-dots"><i></i><i></i><i></i></span>
          <code>ai &amp;&amp; security --defend</code>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ RESEARCH AREAS ═══════════ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">// Research</span>
          <h2>Research Areas</h2>
        </div>
        <a class="see-all" href="/research/">All research →</a>
      </div>
      <div class="area-grid">
        {
          researchAreas.map((area) => (
            <a class="card area-card" href={`/research/#${area.id}`}>
              <span class="area-index" aria-hidden="true">
                {area.index}
              </span>
              <h3>{area.title}</h3>
              <p>{area.short}</p>
              <div class="area-tags">
                {area.keywords.slice(0, 3).map((kw) => (
                  <span class="tag">{kw}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════ SELECTED PUBLICATIONS ═══════════ -->
  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">// Publications</span>
          <h2>Selected Publications</h2>
        </div>
        <a class="see-all" href="/publications/">All publications →</a>
      </div>
      <ul class="pub-list" role="list">
        {
          selectedPubs.map((pub) => (
            <li class="card pub-item">
              <div class="pub-badges">
                <span class="badge-accent">{pub.venueShort}</span>
                {pub.note && <span class="tag">{pub.note}</span>}
                <span class="pub-year">{pub.year}</span>
              </div>
              <h3 class="pub-title">{pub.title}</h3>
              <p class="pub-authors">
                {pub.authors.map((a, i) => (
                  <>
                    {i > 0 && ', '}
                    {a === AUTHOR_ME ? <strong>{a}</strong> : a}
                  </>
                ))}
              </p>
              <p class="pub-venue">
                <em>{pub.venue}</em>
                {pub.volume && `, ${pub.volume}`}
                {pub.pages && `, pp. ${pub.pages}`}
                {pub.articleNo && `, Art. ${pub.articleNo}`}
              </p>
              {pub.doi && (
                <a
                  class="pub-doi"
                  href={`https://doi.org/${pub.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  DOI: {pub.doi}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════ NEWS + BLOG ═══════════ -->
  <section class="section">
    <div class="container duo-grid">
      <div>
        <div class="section-head">
          <div>
            <span class="kicker">// News</span>
            <h2>Latest News</h2>
          </div>
          <a class="see-all" href="/news/">All news →</a>
        </div>
        <ul class="news-list" role="list">
          {
            news.map((item) => (
              <li class="news-item">
                <time class="news-date" datetime={item.data.date.toISOString()}>
                  {fmtDate(item.data.date)}
                </time>
                <p class="news-title">{item.data.title}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <div class="section-head">
          <div>
            <span class="kicker">// Blog</span>
            <h2>From the Blog</h2>
          </div>
          <a class="see-all" href="/blog/">All posts →</a>
        </div>
        <ul class="post-list" role="list">
          {
            posts.map((post) => (
              <li>
                <a class="card post-item" href={`/blog/${post.id}/`}>
                  <time
                    class="post-date"
                    datetime={post.data.date.toISOString()}
                  >
                    {fmtDate(post.data.date)}
                  </time>
                  <h3 class="post-title">{post.data.title}</h3>
                  {post.data.description && (
                    <p class="post-desc">{post.data.description}</p>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── hero ── */
  .hero {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(
        42rem 24rem at 85% -10%,
        color-mix(in srgb, var(--primary) 9%, transparent),
        transparent 70%
      );
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-prompt {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .prompt-path {
    color: var(--primary);
    font-weight: 600;
  }
  .prompt-dollar {
    color: var(--gold-text);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.3em;
    background: var(--gold);
    vertical-align: text-bottom;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.3rem);
    margin-bottom: 0.25em;
  }
  .hero-tagline {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--gold-text);
    margin-bottom: 1.1rem;
  }
  .hero-intro {
    max-width: 38rem;
    font-size: 1.02rem;
    color: var(--text);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }
  .hero-meta {
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  /* hero visual */
  .hero-visual {
    justify-self: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .photo-frame {
    position: relative;
    width: min(17rem, 70vw);
  }
  .photo-frame img {
    display: block;
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow);
  }
  .corner {
    position: absolute;
    width: 2.2rem;
    height: 2.2rem;
    border: 2px solid var(--gold);
    pointer-events: none;
  }
  .corner.tl {
    top: -0.65rem;
    left: -0.65rem;
    border-right: none;
    border-bottom: none;
    border-top-left-radius: 8px;
  }
  .corner.br {
    bottom: -0.65rem;
    right: -0.65rem;
    border-left: none;
    border-top: none;
    border-bottom-right-radius: 8px;
  }
  .term-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .term-chip code {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
  }
  .term-dots {
    display: inline-flex;
    gap: 0.28rem;
  }
  .term-dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.85;
  }
  .term-dots i:nth-child(2) {
    background: var(--primary);
  }
  .term-dots i:nth-child(3) {
    background: var(--border-strong);
  }

  /* ── section chrome ── */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }
  .section-head h2 {
    margin-bottom: 0;
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    padding-bottom: 0.25rem;
  }
  .alt {
    background: var(--bg-inset);
    border-block: 1px solid var(--border);
  }

  /* ── research area cards ── */
  .area-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .area-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.4rem;
    color: inherit;
  }
  .area-card:hover {
    transform: translateY(-3px);
  }
  .area-card:hover h3 {
    color: var(--gold-text);
  }
  .area-index {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--gold-text);
    letter-spacing: 0.12em;
    margin-bottom: 0.7rem;
  }
  .area-index::before {
    content: '/ ';
    color: var(--text-muted);
  }
  .area-card h3 {
    margin-bottom: 0.45em;
    transition: color 0.15s ease;
  }
  .area-card p {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: 1.1rem;
  }
  .area-tags {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ── publications ── */
  .pub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .pub-item {
    padding: 1.3rem 1.5rem;
  }
  .pub-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }
  .pub-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-left: auto;
  }
  .pub-title {
    font-size: 1.05rem;
    margin-bottom: 0.35em;
  }
  .pub-authors {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.2em;
  }
  .pub-authors strong {
    color: var(--text-strong);
  }
  .pub-venue {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.3em;
  }
  .pub-doi {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  /* ── news + blog ── */
  .duo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .news-item {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }
  .news-item:first-child {
    border-top: 1px solid var(--border);
  }
  .news-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--gold-text);
    padding-top: 0.2rem;
    white-space: nowrap;
  }
  .news-title {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text);
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .post-item {
    display: block;
    padding: 1.1rem 1.3rem;
    color: inherit;
  }
  .post-item:hover .post-title {
    color: var(--gold-text);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .post-title {
    font-size: 1rem;
    margin: 0.25em 0 0.3em;
    transition: color 0.15s ease;
  }
  .post-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── responsive ── */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    /* Keep the terminal line + name at the top of the first viewport;
       the photo follows the copy and renders smaller. */
    .photo-frame {
      width: min(13rem, 55vw);
    }
    .area-grid {
      grid-template-columns: 1fr;
    }
    .duo-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .news-item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .pub-year {
      margin-left: 0;
    }
  }
</style>
