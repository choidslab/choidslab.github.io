---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
const readableDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={post.data.title} description={post.data.description}>
  <article class="section">
    <div class="container">
      <div class="post-wrap">
        <nav class="post-nav" aria-label="Breadcrumb">
          <a class="back-link" href="/blog/">
            <span aria-hidden="true">&larr;</span> All posts
          </a>
        </nav>

        <header class="post-head">
          <time
            class="post-date"
            datetime={post.data.date.toISOString()}
            title={readableDate}
          >
            {fmtDate(post.data.date)}
          </time>
          <h1>{post.data.title}</h1>
          {
            post.data.tags.length > 0 && (
              <ul class="post-tags" role="list" aria-label="Tags">
                {post.data.tags.map((tag) => (
                  <li>
                    <span class="tag">#{tag}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <div class="prose">
          <Content />
        </div>

        <footer class="post-foot">
          <a class="btn btn-ghost" href="/blog/">
            <span aria-hidden="true">&larr;</span> Back to Blog
          </a>
        </footer>
      </div>
    </div>
  </article>
</Base>

<style>
  .post-wrap {
    max-width: var(--prose-width);
    margin-inline: auto;
  }

  .post-nav {
    margin-bottom: 1.6rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-head {
    margin-bottom: clamp(1.8rem, 4vw, 2.6rem);
    padding-bottom: clamp(1.2rem, 3vw, 1.8rem);
    border-bottom: 1px solid var(--border);
  }

  .post-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
  }

  .post-head h1 {
    margin-bottom: 0.7rem;
  }

  .post-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-foot {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--border);
  }
</style>
