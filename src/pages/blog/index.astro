---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmtDate = (d: Date) => d.toISOString().slice(0, 10);

const description = `Blog of ${SITE.siteName} — notes on AI × cybersecurity research, tooling, and the occasional meta post.`;
---

<Base title="Blog" description={description}>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <span class="kicker">// BLOG</span>
        <h1>Blog</h1>
        <p class="intro">
          Notes on research, security, and the tools in between. Written in
          Markdown, published with a git push.
        </p>
      </header>

      {
        posts.length === 0 ? (
          <p class="empty">No posts yet — check back soon.</p>
        ) : (
          <ol class="post-list" role="list">
            {posts.map((post) => (
              <li>
                <article class="post card">
                  <time class="post-date" datetime={post.data.date.toISOString()}>
                    {fmtDate(post.data.date)}
                  </time>
                  <div class="post-body">
                    <h2 class="post-title">
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h2>
                    {post.data.description && (
                      <p class="post-desc">{post.data.description}</p>
                    )}
                    {post.data.tags.length > 0 && (
                      <ul class="post-tags" role="list" aria-label="Tags">
                        {post.data.tags.map((tag) => (
                          <li>
                            <span class="tag">#{tag}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Base>

<style>
  .page-head {
    max-width: var(--prose-width);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .intro {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 0;
  }

  .empty {
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    max-width: 54rem;
  }

  .post {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2rem);
    padding: clamp(1.2rem, 3vw, 1.7rem) clamp(1.2rem, 3vw, 2rem);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    padding-top: 0.35rem;
    white-space: nowrap;
  }

  .post-title {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .post-title a {
    color: var(--text-strong);
  }

  .post-title a:hover {
    color: var(--gold-text);
  }

  .post-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
    max-width: 62ch;
  }

  .post-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  @media (max-width: 560px) {
    .post {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .post-date {
      padding-top: 0;
    }
  }
</style>
