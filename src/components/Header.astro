---
import { SITE } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
/* Normalize to trailing-slash form so '/about' and '/about/' both match. */
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : withSlash(pathname).startsWith(withSlash(href));

const brand = SITE.lab.useLabBranding ? SITE.lab.name : SITE.siteName;
---

<header>
  <div class="container inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">▲</span>
      <span class="brand-text">
        <span class="brand-name">{brand}</span>
        <span class="brand-tag">{SITE.tagline}</span>
      </span>
    </a>

    <nav aria-label="Main navigation">
      <ul>
        {
          SITE.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{ active: isActive(item.href) }}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="bars" d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" role="navigation" aria-label="Mobile navigation" hidden>
    <ul>
      {
        SITE.nav.map((item) => (
          <li>
            <a href={item.href} class:list={{ active: isActive(item.href) }}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-strong);
    min-width: 0;
  }
  .brand-mark {
    color: var(--accent);
    font-size: 0.85rem;
    transform: rotate(90deg);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }
  .brand-name {
    font-weight: 750;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--text-muted);
  }
  nav a:hover {
    color: var(--accent);
    background: var(--bg-inset);
  }
  nav a.active {
    color: var(--primary);
    background: var(--primary-soft);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  #nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    cursor: pointer;
  }
  #mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
  }
  #mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem clamp(1.1rem, 4vw, 2rem) 0.9rem;
  }
  #mobile-menu a {
    display: block;
    padding: 0.6rem 0.4rem;
    font-weight: 550;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }
  #mobile-menu li:last-child a {
    border-bottom: none;
  }
  #mobile-menu a.active {
    color: var(--primary);
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }
    #nav-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu!.hasAttribute('hidden');
    if (open) menu!.removeAttribute('hidden');
    else menu!.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
