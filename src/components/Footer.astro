---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
const brand = SITE.lab.useLabBranding ? `${SITE.lab.name} — ${SITE.lab.fullName}` : SITE.siteName;

/* Email is never written into the static HTML (harvester protection):
   the address is split and reversed, then reassembled by JS on load. */
const [emailUser, emailDomain] = SITE.emails[0].split('@');
const rev = (s: string) => s.split('').reverse().join('');
---

<footer>
  <div class="container inner">
    <div class="left">
      <p class="brand">© {year} {brand}</p>
    </div>
    <div class="right">
      <a
        href="#contact"
        class="icon-link js-email"
        data-u={rev(emailUser)}
        data-d={rev(emailDomain)}
        aria-label="Email"
        title="Email"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
          <path d="m3.5 6.5 8.5 6.5 8.5-6.5"></path>
        </svg>
      </a>
      {SITE.socials.googleScholar && (
        <a
          href={SITE.socials.googleScholar}
          class="icon-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google Scholar"
          title="Google Scholar"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3 1 9l4 2.18v6L12 21l7-3.82v-6L23 9l-11-6zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"></path>
          </svg>
        </a>
      )}
      {SITE.socials.github && (
        <a
          href={SITE.socials.github}
          class="icon-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.04 11.04 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path>
          </svg>
        </a>
      )}
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    margin-top: 4rem;
    font-size: 0.88rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.4rem;
  }
  p { margin: 0; }
  .brand { font-weight: 600; color: var(--text-strong); }
  .right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    color: var(--text-muted);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .icon-link:hover {
    color: var(--gold-text);
    background: var(--bg-inset);
  }
</style>

<script>
  // Reassemble the obfuscated mailto link (address never appears in static HTML).
  for (const el of document.querySelectorAll<HTMLAnchorElement>('.js-email')) {
    const r = (s: string) => s.split('').reverse().join('');
    const u = el.dataset.u ?? '';
    const d = el.dataset.d ?? '';
    if (u && d) el.href = `mailto:${r(u)}@${r(d)}`;
  }
</script>
